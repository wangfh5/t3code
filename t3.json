{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Sync Upstream & Rebuild Custom",
      "command": "/home/wangfh/Sync/infra/t3code-custom/sync-upstream.sh",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
